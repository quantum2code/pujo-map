{
  "name": "pujo-map",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "dev:worker": "pnpm --filter worker dev",
    "redis:start": "docker compose -f docker-compose.redis.yml up -d",
    "redis:stop": "docker compose -f docker-compose.redis.yml stop",
    "otp:start": "docker compose -f docker-compose.otp.yml up -d",
    "otp:stop": "docker compose -f docker-compose.otp.yml stop",
    "db:push": "pnpm --filter @pujo-map/db db:push",
    "db:studio": "pnpm --filter @pujo-map/db db:studio",
    "db:generate": "pnpm --filter @pujo-map/db db:generate",
    "db:migrate": "pnpm --filter @pujo-map/db db:migrate"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@pujo-map/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pujo-map/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
